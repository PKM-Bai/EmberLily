# Local SDK, IDE, Gradle and native build state.
local.properties
.gradle/
.idea/
*.iml
**/build/
**/.cxx/
**/.externalNativeBuild/

# Private verification inputs, game files, saves and experiment outputs.
.local/
roms/
saves/
samples/local/
*.gba
*.gb
*.gbc
*.nds
*.sav
*.srm
*.ss
